{
  "nodes": [
    {
      "id": "n_research",
      "ref": "research",
      "title": "Research Topic",
      "adapter": { "name": "mock" },
      "dependencies": [],
      "inputs": {
        "topic": "Petri Nets in AI Workflow Orchestration",
        "depth": "intermediate"
      },
      "outputs": { "notes": "artifact://research-notes.md" },
      "runtime": { "timeout": 180, "retries": 1, "checkpoint": true },
      "prompt": {
        "system_prompt": "You are a technical content researcher. Output structured bullet points, not long prose.",
        "task_prompt": "Gather 5-8 key arguments around the topic. List each source with a one-sentence summary."
      },
      "on_failure": { "strategy": "retry", "max_attempts": 2, "backoff_ms": 2000 }
    },
    {
      "id": "n_outline",
      "ref": "outline",
      "title": "Write Outline",
      "adapter": { "name": "mock" },
      "dependencies": ["research"],
      "inputs": { "notes_ref": "$.outputs.notes" },
      "outputs": { "outline": "artifact://outline.md" },
      "runtime": { "timeout": 120, "retries": 0, "checkpoint": true },
      "prompt": {
        "task_prompt": "Organize the research notes into a three-part outline: Introduction / Body / Conclusion. Annotate 2-3 sub-topics per section."
      },
      "on_failure": { "strategy": "abort" }
    },
    {
      "id": "n_draft",
      "ref": "draft",
      "title": "Write Draft",
      "adapter": { "name": "mock" },
      "dependencies": ["outline"],
      "inputs": { "outline_ref": "$.outputs.outline" },
      "outputs": { "draft": "artifact://draft.md" },
      "runtime": { "timeout": 600, "retries": 1, "checkpoint": true },
      "prompt": {
        "task_prompt": "Write a ~1200-word blog draft following the outline. Use second-person voice and include one code example."
      },
      "on_failure": { "strategy": "retry", "max_attempts": 2, "backoff_ms": 5000 }
    },
    {
      "id": "n_polish",
      "ref": "polish",
      "title": "Polish & Image Briefs",
      "adapter": { "name": "mock" },
      "dependencies": ["draft"],
      "inputs": { "draft_ref": "$.outputs.draft" },
      "outputs": {
        "final": "artifact://post.md",
        "image_briefs": "artifact://image-briefs.json"
      },
      "runtime": { "timeout": 240, "retries": 0, "checkpoint": true },
      "prompt": {
        "task_prompt": "Revise tone and cut redundant paragraphs. Produce 2-3 image briefs for key concepts (purpose / composition / color palette)."
      },
      "on_failure": { "strategy": "abort" }
    }
  ],
  "edges": [
    { "from": "n_research", "to": "n_outline", "kind": "control" },
    { "from": "n_outline", "to": "n_draft", "kind": "control" },
    { "from": "n_draft", "to": "n_polish", "kind": "control" },
    { "from": "n_research", "to": "n_outline", "kind": "data", "binding": "$.outputs.notes" },
    { "from": "n_outline", "to": "n_draft", "kind": "data", "binding": "$.outputs.outline" },
    { "from": "n_draft", "to": "n_polish", "kind": "data", "binding": "$.outputs.draft" }
  ]
}
