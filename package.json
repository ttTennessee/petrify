{
  "name": "petrify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm --workspace @petrify/server run dev",
    "dev:web": "npm --workspace @petrify/web run dev",
    "build": "npm-run-all --serial build:server build:web",
    "build:server": "npm --workspace @petrify/server run build",
    "build:web": "npm --workspace @petrify/web run build",
    "typecheck": "npm-run-all --parallel typecheck:*",
    "typecheck:shared": "npm --workspace @petrify/shared run typecheck",
    "typecheck:server": "npm --workspace @petrify/server run typecheck",
    "typecheck:web": "npm --workspace @petrify/web run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
